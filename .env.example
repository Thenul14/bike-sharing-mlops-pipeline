# Copy to .env and change passwords before starting services.
MARIADB_DATABASE=BikeDB
MARIADB_USER=bikeshare
MARIADB_PASSWORD=replace_with_local_password
MARIADB_ROOT_PASSWORD=replace_with_different_root_password
# Match the user/password above; URL-encode special characters in the URL.
DATABASE_URL=mysql+pymysql://bikeshare:replace_with_local_password@127.0.0.1:3306/BikeDB
REDIS_URL=redis://127.0.0.1:6379/0
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
